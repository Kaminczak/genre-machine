# Source deck - 11MB, not needed to run the site
Genre Machine.pdf

# Legacy stock music, licensing unclear - never publish these
# (locally generated music_* themes are fine to commit)
assets/audio/Music/[0-9].mp3
assets/audio/Music/[0-9][0-9].mp3

# Narration masters are large WAVs; the site ships compressed MP3 instead.
# WAVs stay on disk as the high-quality source, just out of the repo.
assets/audio/*.wav
assets/audio/es/*.wav

# Origin-story videos: local classroom copies of OTHER CREATORS' YouTube
# videos. Played locally when present; the hosted site uses YouTube embeds.
# NEVER commit or publish these - they are not ours to redistribute.
assets/video/

# Downloads dump that landed inside the repo — contains personal documents
# (CVs, legal/medical PDFs) and huge model files. NEVER commit or publish.
assets/images2/

# Generated bundle for the claude.ai/design project (rebuild with
# tools/build_design_bundle.py) — the sheets themselves are committed.
build/

# Local tooling noise
.claude/
__pycache__/
*.pyc
Thumbs.db
desktop.ini
.DS_Store

# Kept private: the generation pipeline (prompts + scripts) and the raw source
# scripts. The live site doesn't need these; they are the reusable "how it's
# made" and stay out of the public repo. Content still ships via data/ + assets/.
tools/
Stories/
